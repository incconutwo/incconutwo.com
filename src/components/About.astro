---
---

<section class="second-page" id="second-page">
      <div class="content-container">

        <!-- Section Title (Scroll Triggered) -->
        <div class="section-header">
          <h2 class="cinematic-title">Some Info <br><span class="text-accent">About Me</span></h2>
        </div>

        <!-- Story Grid -->
        <div class="story-grid">
          <!-- Card 1: Languages -->
          <div class="story-card glass-card" data-speed="0.9">
            <h3 class="card-title">Languages Spoken</h3>
            <ul class="info-list">
              <li><span class="label">Fluent</span> <span class="value">
                  <span class="fi fi-us" title="English"></span>
                  <span class="fi fi-fr" title="French"></span>
                  <span class="fi fi-sa" title="Arabic"></span>
                  <span class="fi fi-ma" title="Moroccan dialect"></span>
                </span></li>
              <li><span class="label">Learning</span> <span class="value"><span class="fi fi-cn" title="Mandarin"></span></span></li>
            </ul>
          </div>

          <!-- Card 2: User Reach & Impact -->
          <div class="story-card glass-card" data-speed="1.1">
            <h3 class="card-title">Active Reach</h3>
            <ul class="info-list contribution-list">
              <li><span class="label">Chrome Extension</span> <span class="value">1,400+ Active Weekly Users</span></li>
              <li><span class="label">Windows Mod</span> <span class="value">2,700+ Windhawk Mod Users</span></li>
              <li><span class="label">Community Mirrors</span> <span class="value">55,000+ Downloads</span></li>
            </ul>
          </div>

          <!-- Card 3: Development Focus -->
          <div class="story-card glass-card" data-speed="1.0">
            <h3 class="card-title">Engineering Focus</h3>
            <ul class="info-list contribution-list">
              <li><span class="label">Specialty</span> <span class="value">Browser Extensions & Custom UI Mods</span></li>
              <li><span class="label">Architecture</span> <span class="value">Astro 5, WebGL, Node REST Proxies</span></li>
              <li><span class="label">Philosophy</span> <span class="value">Privacy-first, Lightweight, Fast UX</span></li>
            </ul>
          </div>

          <!-- Card 4: Google Local Guide Stats -->
          <div class="story-card glass-card" data-speed="1.2">
            <h3 class="card-title">Public Contributions</h3>
            <ul class="info-list contribution-list">
              <li><span class="label">Google Local Guide</span> <span class="value">Level 6 (Oct 2021 – Present)</span></li>
              <li><span class="label">Map Views</span> <span class="value">1.6 Million+ Total Views</span></li>
              <li><span class="label">Data Edits</span> <span class="value">190+ Verified Edits & 18 Road Segments</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
