---
---

<section class="second-page" id="second-page">
      <div class="content-container">

        <!-- Section Title (Scroll Triggered) -->
        <div class="section-header">
          <h2 class="cinematic-title">Some Info <br><span class="text-accent">About Me</span></h2>
        </div>

        <!-- Story Grid -->
        <div class="story-grid">

          <!-- Card 1: Languages -->
          <div class="story-card glass-card" data-speed="0.9">
            <h3 class="card-title">Languages</h3>
            <ul class="info-list">
              <li><span class="label">Speak</span> <span class="value">
                  <span class="fi fi-us" title="English"></span>
                  <span class="fi fi-fr" title="French"></span>
                  <span class="fi fi-sa" title="Arabic"></span>
                  <span class="fi fi-ma" title="Moroccan dialect"></span>
                </span></li>
              <li><span class="label">≈Learning</span> <span class="value"><span class="fi fi-cn"></span></span></li>
              <li><span class="label">Want to learn</span> <span class="value"><span class="fi fi-ru"></span></span>
              </li>
            </ul>
          </div>

          <!-- Card 2: Identity -->
          <div class="story-card glass-card" data-speed="1.1">
            <h3 class="card-title">Identity</h3>
            <ul class="info-list">
              <li><span class="label">Name/Last Name</span> <span class="value"><span class="fi fi-ma"></span></span>
              </li>
              <li><span class="label">I'm</span> <span class="value"><span class="fi fi-ma"></span></span></li>
              <li><span class="label">Inner Voice</span> <span class="value"><span class="fi fi-ma"></span> (<span
                    class="fi fi-us"></span> when focusing)</span></li>
            </ul>
          </div>

          <!-- Card 3: Media Consumption -->
          <div class="story-card glass-card" data-speed="1.0">
            <h3 class="card-title">Media</h3>
            <ul class="info-list">
              <li><span class="label">Phone language</span> <span class="value"><span class="fi fi-us"></span></span>
              </li>
              <li><span class="label">Music</span> <span class="value"><span class="fi fi-us"></span> <span
                    class="fi fi-fr"></span> <span class="fi fi-ma"></span></span></li>
              <li><span class="label">Books</span> <span class="value"><span class="fi fi-fr"></span></span></li>
              <li><span class="label">Movies/Series</span> <span class="value"><span class="fi fi-us"></span> <span
                    class="fi fi-fr"></span></span></li>
            </ul>
          </div>

          <!-- Card 4: Digital Impact & Volunteering -->
          <div class="story-card glass-card" data-speed="1.2">
            <h3 class="card-title">Public Contribution</h3>
            <ul class="info-list contribution-list">
              <li><span class="label">Google Local Guide</span> <span class="value">Level 6 (Oct 2021 – Present)</span></li>
              <li><span class="label">Total Views</span> <span class="value">1.6 Million+ Views</span></li>
              <li><span class="label">Accuracy</span> <span class="value">190+ Edits & 18 Road Segments</span></li>
              <li><span class="label">Community Support</span> <span class="value">532+ Detailed Answers</span></li>
            </ul>
          </div>

        </div>
      </div>
    </section>
