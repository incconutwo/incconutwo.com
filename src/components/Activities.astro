<!-- Cinematic Activities Section -->
<section class="activities-page" id="activities-page">
  <div class="content-container">
    
    <!-- Section Title -->
    <div class="section-header">
      <h2 class="cinematic-title">My <br><span class="text-accent">Activities</span></h2>
    </div>

    <!-- Activities Grid -->
    <div class="activities-grid">
      <!-- Physical -->
      <div class="activity-chip hover-card" style="--hc-color: #FF6B35;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dumbbell"><path d="M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z"/><path d="m2.5 21.5 1.4-1.4"/><path d="m20.1 3.9 1.4-1.4"/><path d="M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z"/><path d="m9.6 14.4 4.8-4.8"/></svg>
          </span>
          <span class="activity-name">Gym</span>
        </div>
      </div>
      <div class="activity-chip hover-card" style="--hc-color: #4ECDC4;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-footprints"><path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.5v2"/><path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.5v2"/><path d="M16 22h4"/><path d="M4 18h4"/></svg>
          </span>
          <span class="activity-name">Walk / Running</span>
        </div>
      </div>
      <div class="activity-chip hover-card" style="--hc-color: #00B4D8;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-waves"><path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></svg>
          </span>
          <span class="activity-name">Swimming</span>
          <span class="activity-detail">4 years of learning</span>
        </div>
      </div>

      <!-- Tech & Creation -->
      <div class="activity-chip hover-card wide" style="--hc-color: #b14cff;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code-xml"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
          </span>
          <span class="activity-name">Web + Extension Coding</span>
          <span class="activity-detail">Chrome / Firefox</span>
        </div>
      </div>
      <div class="activity-chip hover-card" style="--hc-color: #E63946;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clapperboard"><path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z"/><path d="m6.2 5.3 3.1 3.9"/><path d="m12.4 3.4 3.1 4"/><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>
          </span>
          <span class="activity-name">Video / Audio Editing</span>
        </div>
      </div>
      <div class="activity-chip hover-card" style="--hc-color: #F72585;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smartphone"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
          </span>
          <span class="activity-name">Social Media Influencing</span>
        </div>
      </div>

      <!-- Strategy & Finance -->
      <div class="activity-chip hover-card" style="--hc-color: #2DC653;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </span>
          <span class="activity-name">Crypto / Day Trading</span>
        </div>
      </div>
      <div class="activity-chip hover-card" style="--hc-color: #FFD60A;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-coins"><circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/></svg>
          </span>
          <span class="activity-name">Long-term Investment</span>
        </div>
      </div>
      <!-- Chess with Live Lichess Stats -->
      <div class="activity-chip hover-card chess-card wide" id="chess-card" style="--hc-color: #C9ADA7;" data-tilt>
        <div class="hover-card-bg-layer"></div>
        
        <!-- Left content (Label) -->
        <div class="chip-content">
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.735H5.809a1 1 0 0 1-.956-.735L2.019 6.019a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5 21h14"/></svg>
          </span>
          <span class="activity-name">Chess</span>
          <span class="activity-detail">2-3 years of learning</span>
        </div>
        
        <!-- Right content (Lichess Widget) -->
        <div class="lichess-widget">
          <div class="lichess-stats-container" id="lichess-stats">
            <div class="lichess-ratings">
              <div class="lichess-rating-item">
                <span class="lichess-label">Blitz</span>
                <span class="lichess-val" id="lichess-blitz">-</span>
              </div>
              <div class="lichess-rating-item">
                <span class="lichess-label">Rapid</span>
                <span class="lichess-val" id="lichess-rapid">-</span>
              </div>
            </div>
            <div class="lichess-games">
              <span id="lichess-games-count">0</span> games on lichess.org
            </div>
          </div>
        </div>
      </div>

      <!-- Culture -->
      <div class="activity-chip hover-card" style="--hc-color: #E9C46A;" data-tilt>
        <div class="hover-card-content">
          <div class="hover-card-bg-layer"></div>
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
          </span>
          <span class="activity-name">Reading Books</span>
          <span class="activity-detail">Cherub top 1</span>
        </div>
      </div>
      
      <!-- Steam Gaming Widget -->
      <div class="activity-chip hover-card steam-card wide" id="steam-card" style="--hc-color: #66c0f4;" data-tilt>
        <div class="hover-card-bg-layer"></div>
        <!-- Left content (Label) -->
        <div class="chip-content">
          <span class="activity-icon" id="steam-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gamepad-2"><line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-1.026 8.52 1.488 10.428 1.48 1.12 3.626.792 5.09-1.2 1.636-2.22 3.4-2.22 5.04 0 1.464 1.992 3.61 2.32 5.09 1.2 2.514-1.908 1.494-10.376 1.488-10.428A4 4 0 0 0 17.32 5z"/></svg>
          </span>
          <span class="activity-name">Steam Status</span>
        </div>
        
        <!-- Right content (Widget) -->
        <div class="steam-widget">
          <div class="steam-status-info">
            <span class="steam-badge" id="steam-status">Offline</span>
            <span class="activity-detail" id="steam-game">Last played...</span>
          </div>
        </div>
      </div>

      <!-- Music with Spotify Widget -->
      <div class="activity-chip hover-card music-card wide" id="spotify-card" style="--hc-color: #1DB954;" data-tilt>
        <div class="hover-card-bg-layer"></div>
        <!-- Default Content -->
        <div class="chip-content">
          <span class="activity-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-headphones"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>
          </span>
          <span class="activity-name">Listening to Music</span>
        </div>
        
        <!-- Dynamic Widget -->
        <div class="spotify-widget">
          <!-- Offline / Loading State -->
          <div class="spotify-state" id="spotify-offline">
            <div class="spotify-offline-header">
              <span class="spotify-brand-icon"></span>
              <span class="spotify-offline-title">Top Tracks This Month</span>
            </div>
            <div class="spotify-top-tracks" id="spotify-top-tracks-list">
              <!-- Dynamically populated top tracks -->
            </div>
          </div>

          <!-- Live Playing State -->
          <a href="#" target="_blank" class="spotify-state" id="spotify-live" aria-label="Spotify live playing status">
            <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Album Art" class="spotify-art" id="spotify-art">
            <div class="spotify-info">
              <div class="spotify-header">
                <span class="spotify-track" id="spotify-track">Track Name</span>
                <div class="spotify-equalizer">
                  <span class="bar"></span><span class="bar"></span><span class="bar"></span>
                </div>
              </div>
              <span class="spotify-artist" id="spotify-artist">Artist Name</span>
            </div>
          </a>
        </div>
      </div>

    </div>


    <!-- Favorite Hobby Block -->
    <div class="hobby-block glass-card" data-tilt>
      <h3 class="card-title">Favorite Hobby</h3>
      <p class="hobby-text">Talking to people, walking, and gaming.</p>
    </div>

  </div>
</section>