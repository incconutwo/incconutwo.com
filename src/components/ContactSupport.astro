---
---

<section class="contact-support-section" id="contact-support">
      <div class="content-container">
        <div class="contact-support-layout">
          <!-- Left Column: Contact -->
          <div class="contact-card-wrapper glass-card">
            <h2 class="cinematic-title subsection-title">Want to <br><span class="text-accent">contact me?</span></h2>
            <p class="contact-text text-body">
              You can do it via my social media accounts:
            </p>
            <ul class="contact-links-list">
              <li>
                <a href="https://x.com/tnemoroccan" target="_blank" rel="noopener noreferrer" class="contact-link-item" data-copy="@tnemoroccan">
                  <span class="contact-icon-label">Twitter / X:</span> @tnemoroccan
                  <span class="copy-hint-badge" title="Click to copy handle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  </span>
                </a>
              </li>
              <li>
                <a href="https://discord.com/users/867895216228925460" target="_blank" rel="noopener noreferrer"
                  class="contact-link-item" data-copy="@incconu_two">
                  <span class="contact-icon-label">Discord:</span> @incconu_two
                  <span class="copy-hint-badge" title="Click to copy handle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  </span>
                </a>
              </li>
              <li>
                <a href="https://t.me/Incconu_two" target="_blank" rel="noopener noreferrer" class="contact-link-item" data-copy="@Incconu_two">
                  <span class="contact-icon-label">Telegram:</span> @Incconu_two
                  <span class="copy-hint-badge" title="Click to copy handle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  </span>
                </a>
              </li>
            </ul>
            <p class="contact-text text-body email-paragraph">
              Or directly via my email: 
              <button type="button" class="contact-email copy-email-btn" data-copy="rayyan@incconutwo.com">
                <span>rayyan@incconutwo.com</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              </button>
            </p>
          </div>

          <!-- Right Column: Support -->
          <div class="support-card-wrapper glass-card">
            <h2 class="cinematic-title subsection-title">Want to <br><span class="text-accent">support me?</span></h2>
            <p class="support-subtitle text-body">You can do it in many ways:</p>
            <ul class="support-list">
              <li class="support-item notification-support-item">
                <div class="support-item-header">
                  <span class="support-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .738-1.674C19.41 13.916 18 12.037 18 8A6 6 0 0 0 6 8c0 4.037-1.41 5.916-2.738 7.326z"/></svg>
                  </span>
                  <span class="support-text">Sending me a notification directly on my phone</span>
                </div>
                <div class="notification-input-container" id="notification-form-container">
                  <textarea id="notification-msg" placeholder="Type your motivation message here..."
                    maxlength="500"></textarea>
                  <div class="notification-btn-row">
                    <button class="notify-btn send" id="notify-send-btn">Send</button>
                  </div>
                  <div class="notify-status" id="notify-status-text"></div>
                </div>
              </li>
              <li class="support-item">
                <span class="support-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </span>
                <span class="support-text"><a href="https://github.com/incconutwo?tab=repositories" target="_blank"
                    rel="noopener noreferrer" class="support-github-link">Starring my many repos.</a></span>
              </li>
              <li class="support-item">
                <span class="support-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" role="img" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z"/></svg>
                </span>
                <span class="support-text">Helping me directly via <a href="https://ko-fi.com/incconutwo"
                    target="_blank" rel="noopener noreferrer" class="support-kofi-link">Ko-fi</a>.</span>
              </li>
              <li class="support-item">
                <span class="support-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
                </span>
                <span class="support-text"><a href="https://www.linkedin.com/in/incconu-two/" target="_blank"
                    rel="noopener noreferrer" class="support-linkedin-link">Connect with me on LinkedIn.</a></span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Dedication & Thanks -->
        <div class="contact-support-dedication">
          <p class="thanks-parents">Thanks to my parents for everything <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#E63946" stroke="none" style="display:inline-block; vertical-align:middle; margin-left:2px;"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></p>
        </div>

        <!-- Site Footer Info -->
        <footer class="footer-info">
          <p class="footer-text">No AI was used to write the text of this website / thanks for scrolling until here <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#E63946" stroke="none" style="display:inline-block; vertical-align:middle; margin-left:2px;"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </p>
        </footer>
      </div>
    </section>
