---
---

<section class="hero" id="hero">
  <div class="hero-container">

    <!-- Left Side: Text Content -->
    <div class="hero-content">

      <!-- Headline -->
      <div class="hero-headline">
        <h1 class="headline-reveal">
          <div class="line-mask">
            <span class="reveal-item headline-accent">Hello everyone,</span>
          </div>
          <div class="line-mask">
            <span class="reveal-item headline-white" id="scramble-1">I am</span>
          </div>
          <div class="line-mask">
            <span class="reveal-item headline-white" id="scramble-2">incconu_two</span>
          </div>
        </h1>
      </div>

      <!-- Bio Paragraph -->
      <p class="hero-bio text-body">
        16-year-old student & independent developer based in Morocco (1st Bac), building browser extensions, Windows customizations mods, web apps, and many more. I've been online since late 2024 and am quite active in real life, doing a lot of different sports and activities. I'm the typical 'tech guy' at school, and I love music—all of it. New week, new music style, and this is my personal page for everything I do online and offline :->
      </p>

      <!-- Projects CTA Button -->
      <a href="/#projects-section" class="hero-projects-btn">
        <span>View Projects</span>
        <svg viewBox="0 0 24 24"><path d="M5 13h11.83l-5.59 5.59L12 20l8-8-8-8-1.41 1.41 5.59 5.59H5v2z"/></svg>
      </a>

    </div>


    <!-- Right Side: Profile Image -->
    <div class="hero-profile">
      <div class="profile-effect-container">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-labelledby="profile-title">
          <title id="profile-title">Profile Picture with Blob Effect</title>
          <defs>
            <clipPath id="pe-blob-clip">
              <path
                d="M43.1,-68.5C56.2,-58.6,67.5,-47.3,72.3,-33.9C77.2,-20.5,75.5,-4.9,74.2,11.3C72.9,27.6,71.9,44.5,63.8,57.2C55.7,69.8,40.6,78.2,25.5,79.2C10.4,80.1,-4.7,73.6,-20.9,69.6C-37.1,65.5,-54.5,63.9,-66,54.8C-77.5,45.8,-83.2,29.3,-85.7,12.3C-88.3,-4.8,-87.7,-22.3,-79.6,-34.8C-71.5,-47.3,-55.8,-54.9,-41.3,-64.2C-26.7,-73.6,-13.4,-84.7,0.8,-86C15,-87.2,29.9,-78.5,43.1,-68.5Z"
                transform="translate(100 100)" />
            </clipPath>
            <path id="pe-text-path"
              d="M43.1,-68.5C56.2,-58.6,67.5,-47.3,72.3,-33.9C77.2,-20.5,75.5,-4.9,74.2,11.3C72.9,27.6,71.9,44.5,63.8,57.2C55.7,69.8,40.6,78.2,25.5,79.2C10.4,80.1,-4.7,73.6,-20.9,69.6C-37.1,65.5,-54.5,63.9,-66,54.8C-77.5,45.8,-83.2,29.3,-85.7,12.3C-88.3,-4.8,-87.7,-22.3,-79.6,-34.8C-71.5,-47.3,-55.8,-54.9,-41.3,-64.2C-26.7,-73.6,-13.4,-84.7,0.8,-86C15,-87.2,29.9,-78.5,43.1,-68.5C56.2,-58.6,67.5,-47.3,72.3,-33.9C77.2,-20.5,75.5,-4.9,74.2,11.3C72.9,27.6,71.9,44.5,63.8,57.2C55.7,69.8,40.6,78.2,25.5,79.2C10.4,80.1,-4.7,73.6,-20.9,69.6C-37.1,65.5,-54.5,63.9,-66,54.8C-77.5,45.8,-83.2,29.3,-85.7,12.3C-88.3,-4.8,-87.7,-22.3,-79.6,-34.8C-71.5,-47.3,-55.8,-54.9,-41.3,-64.2C-26.7,-73.6,-13.4,-84.7,0.8,-86C15,-87.2,29.9,-78.5,43.1,-68.5C56.2,-58.6,67.5,-47.3,72.3,-33.9C77.2,-20.5,75.5,-4.9,74.2,11.3C72.9,27.6,71.9,44.5,63.8,57.2C55.7,69.8,40.6,78.2,25.5,79.2C10.4,80.1,-4.7,73.6,-20.9,69.6C-37.1,65.5,-54.5,63.9,-66,54.8C-77.5,45.8,-83.2,29.3,-85.7,12.3C-88.3,-4.8,-87.7,-22.3,-79.6,-34.8C-71.5,-47.3,-55.8,-54.9,-41.3,-64.2C-26.7,-73.6,-13.4,-84.7,0.8,-86C15,-87.2,29.9,-78.5,43.1,-68.5"
              transform="translate(100 100)" />
          </defs>

          <!-- Frosted Glass Backdrop Layer -->
          <rect width="200" height="200" class="profile-glass-backdrop" clip-path="url(#pe-blob-clip)" />

          <!-- Profile Image with Translucency -->
          <image href="/assets/images/profile.webp" width="200" height="200" preserveAspectRatio="xMidYMid slice"
            clip-path="url(#pe-blob-clip)" class="profile-image-transparent" />

          <text class="text-content">
            <textPath href="#pe-text-path" startOffset="25%" textLength="520.06" lengthAdjust="spacing">❤ for the
              love of the game. ❤ for the love of the game.
              <animate attributeName="startOffset" from="25%" to="50%" dur="15s" repeatCount="indefinite" />
            </textPath>
          </text>
        </svg>
      </div>
    </div>

  </div>
</section>
