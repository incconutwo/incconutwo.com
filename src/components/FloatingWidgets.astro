---
---

<div class="floating-widgets-container">
  <!-- Floating Music Widget -->
  <div id="fmw-widget" class="floating-music-widget">
    <div class="fmw-header">
      <button id="fmw-toggle" class="fmw-toggle-btn" aria-label="Toggle music widget">
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"
          stroke-linecap="round" stroke-linejoin="round" class="fmw-arrow">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
      <span class="fmw-title">Get a taste of my taste :</span>
    </div>
    <a href="#" target="_blank" class="fmw-content" id="fmw-link" aria-label="Spotify live status">
      <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Album Art" id="fmw-art"
        class="fmw-art">
      <div class="fmw-info">
        <div class="fmw-track" id="fmw-track">Track Name</div>
        <div class="fmw-artist" id="fmw-artist">Artist Name</div>
      </div>
    </a>
  </div>

  <!-- Floating Heart Rate Widget -->
  <div id="fhr-widget" class="floating-heart-rate-widget">
    <div class="fhr-header">
      <button id="fhr-toggle" class="fhr-toggle-btn" aria-label="Toggle heart rate widget">
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"
          stroke-linecap="round" stroke-linejoin="round" class="fhr-arrow">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
      <span class="fhr-title">Live Heart Rate :</span>
    </div>
    <div class="fhr-content">
      <div class="fhr-art-container">
        <span class="fhr-icon" id="fhr-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#ff4b4b" stroke="none"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </span>
      </div>
      <div class="fhr-info">
        <div class="fhr-bpm-row">
          <span class="fhr-bpm" id="fhr-bpm">--</span>
          <span class="fhr-unit">BPM</span>
        </div>
        <span class="fhr-meta" id="fhr-meta">Syncing...</span>
      </div>
    </div>
  </div>
</div>
