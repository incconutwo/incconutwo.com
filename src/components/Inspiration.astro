<section class="inspiration-section" id="inspiration-section">
      <div class="content-container">

        <div class="inspiration-wrapper">
          <!-- The Label -->
          <div class="inspiration-label">
            <span class="bracket">[</span> The saying that inspires me <span class="bracket">]</span>
          </div>

          <!-- The Classic Quote (The "Standard" Logic) -->
          <div class="quote-block classic-quote">
            <div class="quote-mark">“</div>
            <h2 class="quote-text">
              You only live once, but if you do it right, once is enough.
            </h2>
          </div>

          <!-- The Connector Visual -->
          <div class="inspiration-connector">
            <div class="connector-line"></div>
            <div class="connector-node"></div>
          </div>

          <!-- The Personal Version (The "Patch") -->
          <div class="quote-block personal-quote">
            <div class="personal-tag">Personal version:</div>
            <div class="quote-mask">
              <h2 class="quote-text text-gradient">
                "You live only once, so make sure you try everything."
              </h2>
            </div>
          </div>
        </div>

      </div>
    </section>
