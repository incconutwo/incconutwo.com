---
/* src/pages/projects.astro - Redirects /projects directly to home page projects section */
return Astro.redirect('/#projects-section', 302);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content="0;url=/#projects-section" />
  <script is:inline>
    window.location.replace('/#projects-section');
  </script>
  <title>Redirecting to Projects...</title>
</head>
<body>
  <p>Redirecting to <a href="/#projects-section">Projects Section</a>...</p>
</body>
</html>

