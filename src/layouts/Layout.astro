---
import '../styles/index.css';
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <ClientRouter />

  <!-- Favicon & Theme Color -->
  <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
  <link rel="alternate icon" href="/assets/icons/favicon.svg" />

  <!-- Theme Color Meta Tag -->
  <meta name="theme-color" content="#252423" id="themeColorMeta" />

  <!-- Tightened CSP for maximum security and local-first asset speed -->
  <meta http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self' 'unsafe-inline'; worker-src blob:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://cdn.jsdelivr.net https://i.scdn.co https://github-readme-stats-nine-liart-90.vercel.app; font-src 'self'; connect-src 'self' https://vitals.vercel-insights.com;">

  <!-- SEO Meta Tags -->
  <title>{title}</title>
  <link rel="canonical" href="https://incconutwo.com" />
  <meta name="description"
    content="Official website of incconu_two (@tnemoroccan) — browser extension developer and creator of X/Twitter Country Flags, Local Time & Blocker, Gemini Cleaner, and Aurora extensions.">
  <meta name="author" content="incconu_two">
  <meta name="keywords" content="incconu_two, incconutwo, tnemoroccan, Morocco developer, X/Twitter Location Flags, Twitter Location Flags Time Blocker, Twitter country flags extension, Gemini Cleaner browser extension, Aurora for ChatGPT, open source extensions, WebExtension developer">

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content="Official website of incconu_two (@tnemoroccan). Developer of privacy-focused and UX-enhancing browser extensions like Twitter Location Flags and Gemini Cleaner.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://incconutwo.com">
  <meta property="og:image" content="https://incconutwo.com/assets/images/profile.webp">
  <meta property="og:image:width" content="500">
  <meta property="og:image:height" content="500">
  <meta property="og:image:type" content="image/webp">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:creator" content="@tnemoroccan">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content="Developer portfolio and projects by incconu_two, including X/Twitter Country Flags & Blocker and Gemini Cleaner extensions.">
  <meta name="twitter:image" content="https://incconutwo.com/assets/images/profile.webp">

  <!-- JSON-LD Structured Data for SEO / Chatbot GEO -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://incconutwo.com/#person",
          "name": "incconu_two",
          "alternateName": ["incconutwo", "tnemoroccan"],
          "url": "https://incconutwo.com",
          "sameAs": [
            "https://github.com/incconutwo",
            "https://x.com/tnemoroccan",
            "https://reddit.com/user/Ok_Refrigerator9082",
            "https://ko-fi.com/incconutwo",
            "https://www.linkedin.com/in/incconu-two/",
            "https://t.me/Incconu_two",
            "https://discord.com/users/867895216228925460"
          ],
          "description": "Independent developer and open-source contributor specializing in privacy-focused and interface-enhancing browser extensions, Windows customizations, and community digital mapping.",
          "jobTitle": "Software Developer",
          "knowsAbout": [
            "Browser Extensions",
            "Windows Customization",
            "JavaScript",
            "TypeScript",
            "Astro",
            "Google Maps Local Guide",
            "Open Source Software"
          ]
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://incconutwo.com/#twitter-flags",
          "name": "X/Twitter Country Flags, Local Time & Blocker",
          "alternateName": ["X/Twitter Location Flags, Time & Blocker", "twitter-account-location-in-username"],
          "applicationCategory": "BrowserApplication",
          "operatingSystem": "Windows, macOS, Linux, ChromeOS",
          "author": {
            "@id": "https://incconutwo.com/#person"
          },
          "downloadUrl": "https://chromewebstore.google.com/detail/xtwitter-country-flags-bl/dgodabjkaifjlhpcapiohikkklnailla",
          "description": "Browser extension that appends location flags and local time zones next to user handles on X (Twitter), with custom country-based content blocking rules.",
          "offers": {
            "@type": "Offer",
            "price": "0.00",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://incconutwo.com/#gemini-cleaner",
          "name": "Gemini Cleaner",
          "applicationCategory": "BrowserApplication",
          "operatingSystem": "Windows, macOS, Linux, ChromeOS",
          "author": {
            "@id": "https://incconutwo.com/#person"
          },
          "downloadUrl": "https://chromewebstore.google.com/detail/gemini-cleaner-hide-upgra/effcebofhjdoknbmmpbncneoihbbahpg",
          "description": "A lightweight extension designed to clean the Google Gemini interface by removing promotional upgrade banners and premium upsell ads.",
          "offers": {
            "@type": "Offer",
            "price": "0.00",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://incconutwo.com/#taskbar-dock-animation-plus",
          "name": "Taskbar Dock Animation Plus",
          "applicationCategory": "DesktopApplication",
          "operatingSystem": "Windows 11",
          "author": {
            "@id": "https://incconutwo.com/#person"
          },
          "downloadUrl": "https://windhawk.net/mods/taskbar-dock-animation-plus",
          "description": "A Windhawk mod that brings the iconic macOS icon taskbar animation to Windows 11 with smooth physics, multi-monitor support, and compatibility with recent builds.",
          "offers": {
            "@type": "Offer",
            "price": "0.00",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://incconutwo.com/#aurora-extensions",
          "name": "Aurora Extensions Ecosystem",
          "applicationCategory": "BrowserApplication",
          "operatingSystem": "Windows, macOS, Linux, ChromeOS",
          "author": {
            "@id": "https://incconutwo.com/#person"
          },
          "description": "A suite of browser extensions (including Aurora for ChatGPT, Grok, and Gemini) providing ambient blurred glassmorphic backgrounds for AI interfaces.",
          "offers": {
            "@type": "Offer",
            "price": "0.00",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://incconutwo.com/#website",
          "url": "https://incconutwo.com",
          "name": "incconutwo.com",
          "author": {
            "@id": "https://incconutwo.com/#person"
          },
          "description": "Personal developer portfolio and official website of incconu_two."
        }
      ]
    }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg">

  <!-- Vercel Web Analytics -->
  <script is:inline>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body class="page-landing">
  <slot />
  <SpeedInsights />

<!-- Vite Bundled Scripts -->
  <script>
    // 1. Load Vendor Libraries & attach to window first (prevents hoisting ReferenceErrors)
    import '../js/utils/globals.js';

    // 2. Import local modules in dependency order
    import '../js/background/liquid-gradient.js';
    import '../js/background/background-init.js';
    import '../js/components/scrubber.js';
    import '../js/pages/projects.js';
    import '../js/effects/click-explosions.js';
    import '../js/components/hover-card.js';
    import '../js/main.js';
  </script>


</body>
</html>
